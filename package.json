{
  "name": "infocrink-proposal-macro",
  "version": "1.0.0",
  "description": "인포크링크 제안서 자동 발송 매크로",
  "main": "src/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "ui": "node server.js",
    "start": "node src/index.js",
    "dry-run": "node src/index.js --dry-run",
    "reset-counts": "node src/resetCounts.js",
    "check-replies": "node src/checkReplies.js",
    "cleanup-orphans": "node scripts/cleanupOrphanPhotos.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "db:schema": "node scripts/applySchemaPg.js",
    "db:migrate": "node scripts/migrateSupabaseToPg.js",
    "db:verify": "node scripts/verifyPgMigration.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^5.5.0",
    "dayjs": "^1.11.10",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "playwright": "^1.42.0"
  }
}
