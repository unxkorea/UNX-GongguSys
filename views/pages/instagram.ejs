<!-- ═══ 인스타그램 분석 ═══ -->
<!-- [요청] 인스타그램 URL → 평균 릴스 통계 조회 -->
<div class="panel active" id="panel-instagram">
  <div class="card">
    <div class="card-title">📊 인스타그램 평균 릴스 통계</div>
    <p style="font-size:13px;color:#6b7280;margin-bottom:16px">
      인플루언서 사전 검토용. 인스타 프로필 URL을 입력하면 <b>최근 릴스 20개의 평균 통계</b>를 보여줍니다.<br>
      <span style="color:#dc2626">⚠ 별도 인스타 계정 로그인이 필요합니다 (설정 → 인스타분석 계정).</span>
    </p>
    <div class="form-group" style="max-width:560px">
      <label>인스타 프로필 URL</label>
      <input type="text" id="instagramProfileUrl" placeholder="예: https://www.instagram.com/username/  또는  username">
    </div>
    <div class="btn-group" style="margin-bottom:16px">
      <button class="btn btn-outline" id="btnInstaQuick" onclick="startInstaAnalyze('views')">⚡ 빠른 분석 (조회수만)</button>
      <button class="btn btn-primary" id="btnInstaFull" onclick="startInstaAnalyze('full')">전체 분석 (조회수+좋아요+댓글)</button>
      <span style="font-size:12px;color:#94a3b8;align-self:center;margin-left:8px">
        빠른 분석 ~1분 / 전체 분석 ~5-8분
      </span>
    </div>
    <div id="instaStatusBox" style="display:none;background:#eef2ff;border:1px solid #c7d2fe;border-radius:10px;padding:14px 18px;margin-bottom:16px">
      <div style="display:flex;align-items:center;gap:10px;font-size:14px">
        <div class="insta-spinner" style="width:16px;height:16px;border:2.5px solid #c7d2fe;border-top-color:#6366f1;border-radius:50%;animation:insta-spin 0.8s linear infinite"></div>
        <span id="instaStatusStep">시작 중...</span>
      </div>
      <div style="margin-top:8px;font-size:12px;color:#6366f1" id="instaStatusProgress"></div>
    </div>
    <div id="instaResultBox" style="display:none"></div>
    <details style="margin-top:16px">
      <summary style="font-size:12px;color:#6b7280;cursor:pointer">실행 로그</summary>
      <div class="log-area" id="instaLogArea" style="margin-top:8px;max-height:300px">대기 중...</div>
    </details>
  </div>
</div>
