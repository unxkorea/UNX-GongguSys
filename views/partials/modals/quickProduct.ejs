<!-- [요청] 빠른 제품 추가 -->
<!-- [요청] 모달 바깥클릭 닫힘 제거 — ESC/X로만 -->
<div id="quickProductModal" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center">
  <div style="background:white;border-radius:12px;padding:24px;max-width:480px;width:90%;display:flex;flex-direction:column;gap:14px;box-shadow:0 10px 40px rgba(0,0,0,0.2)">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <h3 style="margin:0;font-size:18px">빠른 제품 추가</h3>
      <button class="btn btn-sm" style="background:transparent;color:#6b7280;padding:4px 8px" onclick="closeQuickProductModal()">✕</button>
    </div>
    <div style="font-size:13px;color:#6b7280">관리명은 입력한 "제품명"으로 자동 설정됩니다 (추후 수정 가능). 브랜드명은 선택한 제조사명으로 채워집니다.</div>
    <!-- [요청] 제조사 관리 — 빠른추가 제조사 검색 콤보박스(필수) -->
    <div class="form-group">
      <label>제조사 <span style="color:#ef4444">*</span></label>
      <input id="quickMfrSearch" type="text" placeholder="제조사 검색..." oninput="filterQuickMfrSelect(this.value)" style="margin-bottom:6px">
      <select id="quickMfrSelect"></select>
    </div>
    <div class="form-group">
      <label>제품명 <span style="color:#ef4444">*</span></label>
      <input id="quickProductName" type="text" placeholder="예: 신제품 영양제">
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button class="btn btn-outline btn-sm" onclick="closeQuickProductModal()">취소</button>
      <button class="btn btn-primary btn-sm" onclick="applyQuickProductModal()">추가</button>
    </div>
  </div>
</div>
